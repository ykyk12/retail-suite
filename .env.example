# 复制成 .env 后按需修改（docker compose 会自动读取同目录下的 .env）
# 该文件不进版本库（见 .gitignore），避免把密码提交上去

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=retail_suite
MYSQL_USER=retail
MYSQL_PASSWORD=retail123456

# ---- JWT ----
# 生产必须改成随机串（≥32 字节）：openssl rand -base64 32
JWT_SECRET=please-change-this-secret-in-production-32bytes

# ---- 宿主机端口（改这里即可，无需改 docker-compose.yml）----
# 本机若已装 MySQL 占了 3306，把 MYSQL_HOST_PORT 改成 13306 即可；
# 容器之间仍走 compose 网络内的标准端口（后端连 mysql:3306），不受影响。
FRONTEND_HOST_PORT=80
BACKEND_HOST_PORT=8080
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379

# ---- AI（可选）----
# 不填 API Key 时 AI 模块自动退化为本地规则解析，功能照常可用
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=
